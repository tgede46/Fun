{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for Fun desktop shell",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:default",
    "notification:default",
    "allow-get-recent-projects",
    "allow-open-project",
    "allow-pick-project-folder",
    "allow-pick-project-parent-folder",
    "allow-create-project",
    "allow-create-diagram",
    "allow-load-diagram",
    "allow-save-diagram",
    "allow-list-diagrams",
    "allow-delete-diagram",
    "allow-get-project-settings",
    "allow-set-project-theme",
    "allow-get-openrouter-key-configured",
    "allow-get-ai-status",
    "allow-send-chat-message",
    "allow-reset-diagram",
    "allow-generate-diagram-from-code",
    "allow-set-pomodoro-durations",
    "allow-notify-pomodoro-phase",
    "allow-run-benchmark"
  ]
}
