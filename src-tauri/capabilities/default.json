{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for Fun desktop shell",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:default",
    "allow-get-recent-projects",
    "allow-open-project",
    "allow-pick-project-folder",
    "allow-pick-project-parent-folder",
    "allow-create-project",
    "allow-create-diagram",
    "allow-load-diagram",
    "allow-save-diagram",
    "allow-list-diagrams"
  ]
}
